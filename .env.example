# Copy this file to `.env.local` and adjust the values.

# Public base URL of the Spring Boot API, used by the browser (openapi-fetch client).
NEXT_PUBLIC_API_URL=http://localhost:8081

# Server-side base URL of the Spring Boot API, used by Auth.js and server actions.
# Usually the same as NEXT_PUBLIC_API_URL; differs when the admin runs inside Docker.
API_URL=http://localhost:8081

# Secret used by Auth.js to encrypt the session JWT. Generate with: `openssl rand -base64 32`.
AUTH_SECRET=change-me

# Public URL of this admin panel (used by Auth.js for callbacks/redirects).
AUTH_URL=http://localhost:3000

# WebSocket (STOMP over SockJS/WebSocket) endpoint of the API for real-time dashboard updates.
NEXT_PUBLIC_WS_URL=ws://localhost:8081/ws
